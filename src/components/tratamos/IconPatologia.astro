---
// Iconos de línea propios (24x24, stroke) para patologías y motivos de consulta.
// No existen en bootstrap-icons; heredan color (currentColor) y tamaño (1em)
// del contenedor, igual que Icon.astro.
interface Props {
  name: string;
  class?: string;
}

const { name, class: className } = Astro.props;

const paths: Record<string, string> = {
  tobillo:
    '<path d="M9 3v11.5a3 3 0 0 0 3 3h6a1.8 1.8 0 0 0 .4-3.55l-2.9-.7a3.5 3.5 0 0 1-2.5-2.3L13 8V3"/><path d="M6 21h12"/>',
  'rodilla-lca':
    '<path d="M9 3v3.2a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2V3"/><path d="M9 21v-3.2a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2V21"/><path d="m9.8 10.2 4.4 3.6M14.2 10.2l-4.4 3.6"/>',
  columna:
    '<path d="M12 3v18"/><rect x="8.75" y="5" width="6.5" height="3" rx="1.5"/><rect x="8.75" y="10.5" width="6.5" height="3" rx="1.5"/><rect x="8.75" y="16" width="6.5" height="3" rx="1.5"/>',
  cervical:
    '<circle cx="12" cy="5.8" r="3.2"/><rect x="9.75" y="10.6" width="4.5" height="2.6" rx="1.3"/><rect x="9.75" y="14.6" width="4.5" height="2.6" rx="1.3"/><path d="M5.5 21c1.8-1.7 4-2.5 6.5-2.5s4.7.8 6.5 2.5"/>',
  hombro:
    '<path d="M4 12.5A8 8 0 0 1 12 4.5h.5"/><circle cx="15" cy="9" r="3.2"/><path d="M15 12.2c-.4 2.8-1.3 5.7-3 8.3"/><path d="M19.5 4.5c1 .9 1.8 2 2.2 3.3"/>',
  mancuerna:
    '<path d="m6.5 6.5 11 11"/><path d="m21 21-1-1"/><path d="m3 3 1 1"/><path d="m18 22 4-4"/><path d="m2 6 4-4"/><path d="m3 10 7-7"/><path d="m14 21 7-7"/>',
  desgarro:
    '<path d="M3 18.5c3.5-.4 6-1.6 7.8-3.4"/><path d="m10.8 15.1 2.7-.7M10.8 15.1l1.3 2.4"/><path d="M21 5.5c-3.5.4-6 1.6-7.8 3.4"/><path d="m13.2 8.9-2.7.7M13.2 8.9l-1.3-2.4"/>',
  hueso:
    '<path d="M17 10c.7-.7 1.69 0 2.5 0a2.5 2.5 0 1 0 0-5 .5.5 0 0 1-.5-.5 2.5 2.5 0 1 0-5 0c0 .81.7 1.8 0 2.5l-7 7c-.7.7-1.69 0-2.5 0a2.5 2.5 0 0 0 0 5c.28 0 .5.22.5.5a2.5 2.5 0 1 0 5 0c0-.81-.7-1.8 0-2.5Z"/>',
  'cabeza-dolor':
    '<circle cx="12" cy="9" r="5.5"/><path d="M13.6 6 11 9.4h2.6L11 12.8"/><path d="M5 20.5c1.8-2 4.2-3 7-3s5.2 1 7 3"/>',
  atm:
    '<path d="M12 4.5c-1.8-1.4-4.6-1.6-6 .4-1.2 1.7-.8 4 .2 5.8.9 1.6 1.3 3.4 1.5 5.2.2 1.5.4 3.6 1.6 3.6 1.4 0 1-2.6 2.7-2.6s1.3 2.6 2.7 2.6c1.2 0 1.4-2.1 1.6-3.6.2-1.8.6-3.6 1.5-5.2 1-1.8 1.4-4.1.2-5.8-1.4-2-4.2-1.8-6-.4Z"/>',
  ciclo:
    '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M3 21v-5h5"/>',
  cerebro:
    '<path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z"/><path d="M12 5a3 3 0 1 1 5.997.125 4 4 0 0 1 2.526 5.77 4 4 0 0 1-.556 6.588A4 4 0 1 1 12 18Z"/><path d="M15 13a4.5 4.5 0 0 1-3-4 4.5 4.5 0 0 1-3 4"/>',
};

const inner = paths[name];
if (!inner) throw new Error(`IconPatologia: ícono desconocido "${name}"`);
---
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  width="1em"
  height="1em"
  fill="none"
  stroke="currentColor"
  stroke-width="1.8"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  class={className}
  set:html={inner}
/>
