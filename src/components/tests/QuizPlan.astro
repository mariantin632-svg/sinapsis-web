---
import sitio from '../../content/sitio.json';
import { preguntas, resultados } from '../../lib/quiz-plan';
import Icon from '../shared/Icon.astro';

const wa = `https://wa.me/${sitio.contacto.whatsapp}`;
---
<div data-quiz>
  <div data-quiz-body>
    <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
      <span data-quiz-progress>Pregunta 1 de {preguntas.length}</span>
    </div>
    <div class="h-1.5 bg-gray-100 rounded-full overflow-hidden mb-6">
      <div data-quiz-bar class="h-full bg-sn-sage-dark rounded-full transition-all duration-300" style="width: 0%"></div>
    </div>
    <h3 data-quiz-question class="m-0 mb-4 font-display font-semibold text-[1.1rem] text-sn-violet"></h3>
    <div data-quiz-options class="grid gap-2.5"></div>
  </div>

  <div data-quiz-result class="hidden text-center py-2">
    <p class="m-0 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage-dark">Tu plan ideal</p>
    <div data-result-nombre class="font-display font-semibold text-[1.6rem] text-sn-violet mt-1.5"></div>
    <p data-result-desc class="m-0 text-sm leading-relaxed text-gray-500 mt-2 max-w-md mx-auto"></p>
    <div class="flex flex-wrap gap-2.5 justify-center mt-6">
      <a data-result-link class="hidden px-5 py-2.5 rounded-full bg-gradient-to-br from-sn-violet to-sn-violet-light text-white font-semibold text-sm transition-all duration-300 hover:-translate-y-0.5 hover:shadow-[0_6px_18px_rgba(48,22,109,0.25)]">Ver el plan →</a>
      <a data-result-wa target="_blank" rel="noopener" class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full border-[1.5px] border-gray-200 text-sn-violet font-semibold text-sm hover:border-sn-sage hover:bg-[#f4faf8] transition"><Icon name="whatsapp" /> Consultar</a>
    </div>
    <button data-quiz-reset class="block mx-auto mt-5 text-xs text-gray-500 underline hover:text-sn-violet">Volver a empezar</button>
  </div>
</div>

<script define:vars={{ preguntas, resultados, wa }}>
  document.querySelectorAll('[data-quiz]').forEach((root) => {
    const elBody = root.querySelector('[data-quiz-body]');
    const elResult = root.querySelector('[data-quiz-result]');
    const elProgress = root.querySelector('[data-quiz-progress]');
    const elBar = root.querySelector('[data-quiz-bar]');
    const elQ = root.querySelector('[data-quiz-question]');
    const elOpts = root.querySelector('[data-quiz-options]');
    let idx = 0;
    let scores = {};

    function render() {
      const pre = preguntas[idx];
      elProgress.textContent = `Pregunta ${idx + 1} de ${preguntas.length}`;
      elBar.style.width = `${(idx / preguntas.length) * 100}%`;
      elQ.textContent = pre.q;
      elOpts.innerHTML = '';
      pre.opciones.forEach((op) => {
        const b = document.createElement('button');
        b.className = 'text-left text-sm text-gray-700 bg-[#f6f4fb] hover:bg-[#f4faf8] border border-transparent hover:border-sn-sage rounded-xl px-4 py-3 transition';
        b.textContent = op.t;
        b.addEventListener('click', () => {
          for (const k in op.p) scores[k] = (scores[k] || 0) + op.p[k];
          idx++;
          if (idx < preguntas.length) render();
          else finish();
        });
        elOpts.appendChild(b);
      });
    }

    function finish() {
      let best = null, bestVal = -1;
      for (const k in scores) if (scores[k] > bestVal) { bestVal = scores[k]; best = k; }
      const r = resultados[best] || resultados['kine-10'];
      root.querySelector('[data-result-nombre]').textContent = r.nombre;
      root.querySelector('[data-result-desc]').textContent = r.desc;
      const link = root.querySelector('[data-result-link]');
      if (r.href) { link.href = r.href; link.classList.remove('hidden'); }
      else link.classList.add('hidden');
      root.querySelector('[data-result-wa]').href =
        `${wa}?text=${encodeURIComponent(`Hola! Hice el test de la web y me recomendó: ${r.nombre}. Quería consultar.`)}`;
      elBody.classList.add('hidden');
      elResult.classList.remove('hidden');
    }

    function reset() {
      idx = 0; scores = {};
      elResult.classList.add('hidden');
      elBody.classList.remove('hidden');
      render();
    }

    root.querySelector('[data-quiz-reset]').addEventListener('click', reset);
    render();
  });
</script>
