---
import sitio from '../../content/sitio.json';
const wa = `https://wa.me/${sitio.contacto.whatsapp}`;

// Cada opción suma puntos a uno o más planes. Gana el de mayor puntaje.
const preguntas = [
  {
    q: '¿Cuál es tu objetivo principal?',
    opciones: [
      { t: 'Resolver una molestia reciente o leve', p: { 'kine-inicio': 3 } },
      { t: 'Tratar una lesión con diagnóstico', p: { 'kine-10': 3 } },
      { t: 'Conocer mi punto de partida antes de entrenar', p: { 'evaluacion-postural': 2, 'evaluacion-deportiva': 1 } },
      { t: 'Medir mi rendimiento deportivo', p: { 'evaluacion-deportiva': 3 } },
    ],
  },
  {
    q: '¿Cuántas sesiones creés que necesitás?',
    opciones: [
      { t: 'Pocas, es algo puntual', p: { 'kine-inicio': 2 } },
      { t: 'Un tratamiento completo hasta el alta', p: { 'kine-10': 2 } },
      { t: 'Por ahora solo quiero evaluarme', p: { 'evaluacion-postural': 1, 'evaluacion-deportiva': 1, 'evaluacion-nutricional': 1 } },
    ],
  },
  {
    q: 'Si te evaluaras hoy, ¿qué te gustaría conocer?',
    opciones: [
      { t: 'Mi postura y de dónde viene el dolor', p: { 'evaluacion-postural': 2 } },
      { t: 'Mi fuerza, saltos y asimetrías', p: { 'evaluacion-deportiva': 2 } },
      { t: 'Mi composición corporal y alimentación', p: { 'evaluacion-nutricional': 3 } },
      { t: 'Nada puntual, vengo por tratamiento', p: { 'kine-10': 1, 'kine-inicio': 1 } },
    ],
  },
];

const resultados = {
  'kine-inicio': { nombre: 'KINE INICIO', desc: 'Cinco sesiones con evaluación incluida para resolver lo puntual. Si necesitás continuar, pasás al KINE 10 pagando la diferencia.', href: '/planes/kine-inicio' },
  'kine-10': { nombre: 'KINE 10', desc: 'Un tratamiento completo de 10 sesiones, de la evaluación al alta.', href: '/planes/kine-10' },
  'evaluacion-postural': { nombre: 'EVALUACIÓN POSTURAL', desc: 'Un diagnóstico claro de tu postura, con informe escrito.', href: '/planes/evaluacion-postural' },
  'evaluacion-deportiva': { nombre: 'EVALUACIÓN DEPORTIVA', desc: 'Saltos, fuerza y asimetrías medidos con datos reales.', href: '/planes/evaluacion-deportiva' },
  'evaluacion-nutricional': { nombre: 'EVALUACIÓN NUTRICIONAL', desc: 'Composición corporal, hábitos y laboratorio interpretados por una nutricionista.', href: '/planes/evaluacion-nutricional' },
};
---
<div data-quiz>
  <div data-quiz-body>
    <div class="flex items-center justify-between text-xs text-gray-500 mb-3">
      <span data-quiz-progress>Pregunta 1 de {preguntas.length}</span>
      <button data-quiz-reset class="hidden underline hover:text-violet-deep">Reiniciar</button>
    </div>
    <div class="h-1.5 bg-gray-200 rounded-full overflow-hidden mb-5">
      <div data-quiz-bar class="h-full bg-accent-mint transition-all" style="width: 0%"></div>
    </div>
    <h3 data-quiz-question class="text-lg font-bold text-violet-deep mb-4"></h3>
    <div data-quiz-options class="grid gap-2"></div>
  </div>

  <div data-quiz-result class="hidden text-center">
    <div class="text-xs uppercase tracking-widest text-gray-500">Tu plan ideal</div>
    <div data-result-nombre class="text-2xl font-bold text-sinapsis-purple mt-1"></div>
    <p data-result-desc class="text-sm text-gray-600 mt-2 max-w-md mx-auto"></p>
    <div class="flex flex-wrap gap-3 justify-center mt-5">
      <a data-result-link class="bg-sinapsis-purple text-white px-5 py-2.5 rounded-pill text-sm font-bold hover:opacity-90 transition hidden">Ver el plan →</a>
      <a data-result-wa target="_blank" rel="noopener" class="border border-sinapsis-purple text-sinapsis-purple px-5 py-2.5 rounded-pill text-sm font-bold hover:bg-sinapsis-purple/5 transition">📱 Consultar</a>
    </div>
    <button data-quiz-reset2 class="block mx-auto mt-5 text-xs text-gray-500 underline hover:text-violet-deep">Volver a empezar</button>
  </div>
</div>

<script define:vars={{ preguntas, resultados, wa }}>
  document.querySelectorAll('[data-quiz]').forEach((root) => {
    const elBody = root.querySelector('[data-quiz-body]');
    const elResult = root.querySelector('[data-quiz-result]');
    const elProgress = root.querySelector('[data-quiz-progress]');
    const elBar = root.querySelector('[data-quiz-bar]');
    const elQ = root.querySelector('[data-quiz-question]');
    const elOpts = root.querySelector('[data-quiz-options]');
    let idx = 0;
    let scores = {};

    function render() {
      const pre = preguntas[idx];
      elProgress.textContent = `Pregunta ${idx + 1} de ${preguntas.length}`;
      elBar.style.width = `${(idx / preguntas.length) * 100}%`;
      elQ.textContent = pre.q;
      elOpts.innerHTML = '';
      pre.opciones.forEach((op) => {
        const b = document.createElement('button');
        b.className = 'text-left text-sm text-violet-deep bg-cream-bg hover:bg-violet-deep/5 border border-gray-200 rounded-card px-4 py-3 transition';
        b.textContent = op.t;
        b.addEventListener('click', () => {
          for (const k in op.p) scores[k] = (scores[k] || 0) + op.p[k];
          idx++;
          if (idx < preguntas.length) render();
          else finish();
        });
        elOpts.appendChild(b);
      });
    }

    function finish() {
      let best = null, bestVal = -1;
      for (const k in scores) if (scores[k] > bestVal) { bestVal = scores[k]; best = k; }
      const r = resultados[best] || resultados['premier-kine'];
      root.querySelector('[data-result-nombre]').textContent = r.nombre;
      root.querySelector('[data-result-desc]').textContent = r.desc;
      const link = root.querySelector('[data-result-link]');
      if (r.href) { link.href = r.href; link.classList.remove('hidden'); }
      else link.classList.add('hidden');
      root.querySelector('[data-result-wa]').href =
        `${wa}?text=${encodeURIComponent(`Hola! Hice el test de la web y me recomendó: ${r.nombre}. Quería consultar.`)}`;
      elBody.classList.add('hidden');
      elResult.classList.remove('hidden');
    }

    function reset() {
      idx = 0; scores = {};
      elResult.classList.add('hidden');
      elBody.classList.remove('hidden');
      render();
    }

    root.querySelectorAll('[data-quiz-reset], [data-quiz-reset2]').forEach((b) =>
      b.addEventListener('click', reset));
    render();
  });
</script>
