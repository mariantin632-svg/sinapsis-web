---
import contenido from '../../content/orientador.json';

// Las zonas salen del mismo JSON que usa el orientador: una sola fuente de verdad.
// Cada chip abre /orientador con la primera pregunta ya contestada.
const zonas = contenido.zonas;
---
<section class="max-w-[1200px] mx-auto mt-16 px-6">
  <div class="relative overflow-hidden rounded-3xl bg-white px-8 py-11 md:px-10 md:py-12 shadow-[0_12px_48px_rgba(48,22,109,0.12)] border border-gray-100">
    <div class="grid lg:grid-cols-[1fr_1.15fr] gap-9 items-center">
      <div>
        <p class="m-0 mb-2 text-xs font-semibold tracking-[1px] uppercase text-sn-sage-dark">¿Kinesiología, osteopatía o médico?</p>
        <h2 class="m-0 mb-3 font-display font-semibold text-[clamp(1.7rem,3.5vw,2.3rem)] leading-[1.15] tracking-[-0.02em] text-sn-violet">
          ¿Por dónde empiezo?
        </h2>
        <p class="m-0 text-[15px] leading-relaxed text-gray-600 max-w-[440px]">
          Si te duele algo y no sabés a quién pedirle turno, contestá unas preguntas
          y te decimos por dónde arrancaríamos nosotros. Dos minutos, sin datos y
          sin compromiso.
        </p>
      </div>

      <div>
        <p class="m-0 mb-3.5 text-[13px] font-semibold text-gray-800">Empezá por acá: ¿dónde te molesta?</p>
        <div class="flex flex-wrap gap-2">
          {zonas.map((z) => (
            <a
              href={`/orientador?zona=${z.id}`}
              class="inline-flex items-center px-4 py-2.5 rounded-full border border-gray-200 bg-white text-[13.5px] text-gray-800 hover:border-sn-sage hover:bg-sn-sage/10 hover:-translate-y-0.5 transition-all duration-200"
            >{z.label}</a>
          ))}
        </div>
        <a
          href="/orientador"
          class="group inline-flex items-center gap-2 mt-6 text-[14px] font-semibold text-sn-violet hover:text-sn-violet-light transition"
        >Hacer el test completo <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></a>
      </div>
    </div>
  </div>
</section>
