---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/shared/PageHeader.astro';
import FaqAccordion from '../components/shared/FaqAccordion.astro';
import CtaWhatsApp from '../components/shared/CtaWhatsApp.astro';
import faqData from '../content/faq.json';
import type { FaqItem } from '../content/_types';

const faq = faqData as FaqItem[];

const categorias = [
  { key: 'turnos', label: 'Turnos y reservas' },
  { key: 'pagos', label: 'Pagos' },
  { key: 'planes', label: 'Planes' },
  { key: 'obras_sociales', label: 'Obras sociales' },
  { key: 'otros', label: 'Otros' },
] as const;

const grouped = categorias
  .map((cat) => ({ ...cat, items: faq.filter((f) => f.categoria === cat.key) }))
  .filter((g) => g.items.length > 0);

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.pregunta,
    acceptedAnswer: { '@type': 'Answer', text: item.respuesta },
  })),
};
---
<BaseLayout title="Preguntas frecuentes · Sinapsis®">
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)}></script>

  <PageHeader
    kicker="FAQ"
    title="Preguntas frecuentes"
    subtitle="Turnos, pagos, planes y obras sociales. Si no encontrás lo que buscás, escribinos."
  />

  <section class="max-w-[1200px] mx-auto px-6 py-10 md:py-14">
    <div class="max-w-[820px] flex flex-col gap-11">
      {grouped.map((g) => (
        <div>
          <h2 class="m-0 mb-4 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage-dark">{g.label}</h2>
          <FaqAccordion items={g.items} />
        </div>
      ))}
    </div>

    <div class="max-w-[820px] mt-12 rounded-2xl bg-[#f4faf8] border border-sn-sage/30 px-6 py-6 md:px-8 flex flex-wrap items-center justify-between gap-4">
      <p class="m-0 text-[15px] text-gray-600">¿Te quedó alguna duda?</p>
      <CtaWhatsApp text="Escribinos" message="Hola! Tenía una consulta." variant="violet" size="sm" />
    </div>
  </section>
</BaseLayout>
