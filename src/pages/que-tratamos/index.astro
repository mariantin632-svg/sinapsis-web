---
import BaseLayout from '../../layouts/BaseLayout.astro';
import patologiasData from '../../content/patologias.json';
import sitio from '../../content/sitio.json';
import type { Patologia } from '../../content/_types';
import { buildWhatsAppUrl } from '../../lib/whatsapp';
import IconPatologia from '../../components/tratamos/IconPatologia.astro';

const patologias = (patologiasData as Patologia[]).sort((a, b) => a.orden - b.orden);
const turnitoUrl = sitio.turnito?.hub ?? '#';

const whatsappGeneral = buildWhatsAppUrl({
  phone: sitio.contacto.whatsapp,
  text: 'Hola! Llegué desde la web y quería consultar por mi lesión.',
});
const whatsappOsteo = buildWhatsAppUrl({
  phone: sitio.contacto.whatsapp,
  text: 'Hola! Quería consultar por una sesión de osteopatía.',
});
const whatsappPorPatologia = (p: Patologia) =>
  buildWhatsAppUrl({
    phone: sitio.contacto.whatsapp,
    text: `Hola! Quería consultar por ${p.nombre.toLowerCase()}.`,
  });

const motivosOsteo = [
  {
    icono: 'cabeza-dolor',
    titulo: 'Cefaleas y migrañas',
    texto: 'Dolores de cabeza recurrentes con componente cervical o tensional: buscamos qué los dispara y los sostiene.',
  },
  {
    icono: 'atm',
    titulo: 'ATM y bruxismo',
    texto: 'Dolor de mandíbula, chasquidos al abrir, apretar los dientes de noche: la articulación que nadie revisa.',
  },
  {
    icono: 'ciclo',
    titulo: 'Dolor que siempre vuelve',
    texto: 'Lumbalgias o cervicalgias a repetición aunque "los estudios dan bien": revisamos el resto del sistema.',
  },
  {
    icono: 'cerebro',
    titulo: 'Estrés y sistema nervioso',
    texto: 'Cuadros donde la tensión sostenida amplifica el dolor: trabajamos la regulación, no solo el síntoma.',
  },
];

const pasos = [
  {
    titulo: 'Evaluación inicial',
    texto: 'Historia clínica, pruebas funcionales y mediciones objetivas: nos acercamos lo más posible al diagnóstico y definimos el punto de partida.',
  },
  {
    titulo: 'Plan a tu medida',
    texto: 'Fases, frecuencia semanal y objetivos concretos definidos con vos. Sabés desde el día uno hacia dónde vamos y cómo.',
  },
  {
    titulo: 'Tratamiento activo',
    texto: 'Sesiones personalizadas en el centro, ejercicios para casa con videos y consultas por WhatsApp entre sesiones.',
  },
  {
    titulo: 'Reevaluación y alta',
    texto: 'Volvemos a medir y comparamos contra el punto de partida. El alta llega cuando los criterios se cumplen, no antes ni después.',
  },
];
---
<BaseLayout
  title="Qué tratamos · Sinapsis"
  description="Lesiones que tratamos en Sinapsis, José C. Paz: esguinces, post-quirúrgicos, lumbalgia, tendinopatías y más, junto al abordaje osteopático. Evaluación con mediciones y plan por fases."
>
  <!-- hero -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #1f0f48 0%, #30166d 70%, #3a2178 100%);">
    <div class="absolute inset-0 opacity-5 pattern-cross"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 py-16 md:py-20">
      <p class="m-0 mb-2.5 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage">Qué tratamos</p>
      <h1 class="m-0 font-display font-semibold text-[clamp(2.1rem,5vw,3rem)] leading-[1.12] tracking-[-0.02em] text-white max-w-[720px]">
        Tu lesión tiene nombre.<br />Y un plan para resolverla.
      </h1>
      <p class="m-0 mt-[18px] text-[16px] leading-relaxed text-white/80 max-w-[600px]">
        Cada lesión se rehabilita distinto. Acá tenés algunas de las que más tratamos:
        qué evaluamos, en qué fases avanzamos y cuándo estás para el alta.
        Si la tuya no aparece, escribinos igual — la lista completa es mucho más larga.
      </p>
    </div>
  </section>

  <!-- grilla kine / traumatología -->
  <section class="max-w-[1200px] mx-auto px-6 pt-16 pb-14 md:pt-20">
    <p class="m-0 mb-2.5 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage-dark">Kinesiología · Traumatología y deporte</p>
    <h2 class="m-0 mb-9 font-display font-semibold text-[clamp(1.9rem,4vw,2.6rem)] leading-[1.12] tracking-[-0.02em] text-sn-violet max-w-[640px]">
      Algunas de las lesiones que más vemos en el centro.
    </h2>
    <div class="grid grid-cols-[repeat(auto-fill,minmax(270px,1fr))] gap-5">
      {patologias.map((p) => (
        <a
          href={p.pagina ? `/que-tratamos/${p.slug}` : whatsappPorPatologia(p)}
          target={p.pagina ? undefined : '_blank'}
          rel={p.pagina ? undefined : 'noopener'}
          class="group bg-white rounded-2xl p-6 shadow-[0_2px_8px_rgba(48,22,109,0.08)] border border-gray-100 flex flex-col transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_8px_32px_rgba(48,22,109,0.16)]"
        >
          <span class="w-[46px] h-[46px] rounded-xl bg-gradient-to-br from-sn-violet to-sn-violet-light flex items-center justify-center text-white text-[23px] mb-4">
            <IconPatologia name={p.icono} />
          </span>
          <h3 class="m-0 mb-1.5 font-display font-semibold text-[17px] text-gray-900">{p.nombre}</h3>
          <p class="m-0 mb-4 text-[13px] leading-normal text-gray-500">{p.descripcion_corta}</p>
          <span class="mt-auto inline-flex items-center gap-1.5 text-[13.5px] font-semibold text-sn-violet group-hover:text-sn-violet-light transition">
            {p.pagina ? 'Ver tratamiento' : 'Consultar'}
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span>
          </span>
        </a>
      ))}
    </div>
    <p class="m-0 mt-9 text-sm text-gray-500">
      ¿Tu lesión no está en la lista? Escribinos por
      <a href={whatsappGeneral} target="_blank" rel="noopener" class="font-semibold text-sn-violet hover:text-sn-violet-light transition">WhatsApp</a>
      y te orientamos.
    </p>
  </section>

  <!-- osteopatía -->
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #1f0f48 0%, #30166d 70%, #3a2178 100%);">
    <div class="absolute inset-0 opacity-5 pattern-cross"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 py-16 md:py-20">
      <p class="m-0 mb-2.5 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage">Osteopatía · Sesiones uno a uno</p>
      <h2 class="m-0 mb-4 font-display font-semibold text-[clamp(1.9rem,4vw,2.6rem)] leading-[1.12] tracking-[-0.02em] text-white max-w-[660px]">
        Cuando el dolor no se explica solo por lo mecánico.
      </h2>
      <p class="m-0 mb-11 text-[15px] leading-relaxed text-white/75 max-w-[620px]">
        La osteopatía mira el cuerpo como un sistema: columna, cráneo, vísceras y
        sistema nervioso autónomo. En sesiones uno a uno buscamos el origen de
        cuadros que vuelven una y otra vez, y lo trabajamos en conjunto con tu kinesiología.
      </p>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-6">
        {motivosOsteo.map((m) => (
          <div class="border-t border-white/15 pt-[22px]">
            <span class="inline-flex items-center justify-center w-[50px] h-[50px] rounded-[14px] bg-sn-sage/15 text-sn-sage text-2xl mb-4">
              <IconPatologia name={m.icono} />
            </span>
            <h3 class="m-0 mb-[7px] font-display font-semibold text-[18px] text-white">{m.titulo}</h3>
            <p class="m-0 text-[13.5px] leading-relaxed text-white/70">{m.texto}</p>
          </div>
        ))}
      </div>
      <div class="flex flex-wrap gap-3.5 mt-11">
        <a
          href={turnitoUrl}
          target="_blank"
          rel="noopener"
          class="group inline-flex items-center gap-2.5 px-[26px] py-[15px] rounded-full bg-sn-sage text-sn-deep font-semibold text-[15px] hover:bg-sn-sage-light hover:-translate-y-0.5 hover:shadow-[0_10px_30px_rgba(150,194,185,0.4)] transition-all duration-300"
        >Agendar osteopatía <span class="inline-block transition-transform duration-300 group-hover:translate-x-1">→</span></a>
        <a
          href={whatsappOsteo}
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2.5 px-[26px] py-[15px] rounded-full border border-white/35 text-white font-semibold text-[15px] hover:border-sn-sage hover:text-sn-sage-light hover:-translate-y-0.5 transition-all duration-300"
        >Consultar por WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- cómo trabajamos -->
  <section class="max-w-[1200px] mx-auto px-6 pt-16 pb-20 md:pt-20">
    <p class="m-0 mb-2.5 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage-dark">Cómo trabajamos</p>
    <h2 class="m-0 mb-9 font-display font-semibold text-[clamp(1.9rem,4vw,2.6rem)] leading-[1.12] tracking-[-0.02em] text-sn-violet max-w-[620px]">
      Evaluación y tratamiento: así es el recorrido.
    </h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(230px,1fr))] gap-5">
      {pasos.map((paso, i) => (
        <div class="bg-white rounded-2xl p-6 shadow-[0_2px_8px_rgba(48,22,109,0.08)] border border-gray-100">
          <span class="inline-flex items-center justify-center w-10 h-10 rounded-full bg-gradient-to-br from-sn-violet to-sn-violet-light text-white font-display font-semibold text-[16px] mb-4">{i + 1}</span>
          <h3 class="m-0 mb-[7px] font-display font-semibold text-[16.5px] text-gray-900">{paso.titulo}</h3>
          <p class="m-0 text-[13px] leading-relaxed text-gray-500">{paso.texto}</p>
        </div>
      ))}
    </div>
    <p class="m-0 mt-6 text-[13px] text-gray-400">
      En los planes de kinesiología, la evaluación inicial incluye su informe escrito y el informe de alta está disponible a pedido.
      En osteopatía, la evaluación forma parte de la sesión y se apoya en la valoración clínica del profesional.
    </p>
  </section>
</BaseLayout>
