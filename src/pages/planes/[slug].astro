---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaWhatsApp from '../../components/shared/CtaWhatsApp.astro';
import Icon from '../../components/shared/Icon.astro';
import planesData from '../../content/planes.json';
import type { Plan } from '../../content/_types';
import { formatARS } from '../../lib/precios';

export async function getStaticPaths() {
  const planes = (planesData as Plan[]).filter((plan) => !plan.oculto);
  return planes.map((plan) => ({ params: { slug: plan.slug }, props: { plan } }));
}

interface Props {
  plan: Plan;
}

const { plan } = Astro.props;
const tipoLabel = plan.tipo_label ?? (plan.tipo === 'finito' ? 'Tratamiento' : 'Suscripción');

// De menos a más: la duración más barata va primero y es la destacada.
const duraciones = [...plan.duraciones].sort((a, b) => a.total - b.total);
const principal = duraciones[0];
const mensajeWhatsApp = `Hola! Me interesa el Plan ${plan.nombre} (${principal.label}, ${formatARS(principal.total)}).`;
---
<BaseLayout title={`Plan ${plan.nombre} · Sinapsis®`} description={plan.hook}>
  <section class="relative overflow-hidden" style="background: linear-gradient(135deg, #1f0f48 0%, #30166d 65%, #3a2178 100%);">
    <div class="absolute inset-0 opacity-[0.05] pattern-cross"></div>
    <div class="relative max-w-[1200px] mx-auto px-6 pt-14 pb-16 md:pt-20 md:pb-20">
      <a href="/planes" class="inline-flex items-center gap-1.5 text-[13px] font-medium text-white/60 hover:text-white transition">
        <Icon name="arrow-left" /> Todos los planes
      </a>
      <div class="max-w-[760px] mt-7">
        <p class="m-0 mb-3 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage">{tipoLabel} · {plan.subtitulo}</p>
        <span class="inline-block px-3 py-1 rounded-full bg-white/10 border border-white/15 text-white text-xs font-semibold tracking-[1.5px]">{plan.nombre}</span>
        <h1 class="m-0 mt-4 font-display font-semibold text-[clamp(2rem,5vw,3.1rem)] leading-[1.1] tracking-[-0.02em] text-white">{plan.hook}</h1>
        <p class="m-0 mt-4 text-base leading-relaxed text-white/75">{plan.para_quien}</p>
      </div>
    </div>
  </section>

  <section class="max-w-[1200px] mx-auto px-6 py-14 md:py-20 grid gap-10 lg:grid-cols-[1fr_minmax(320px,420px)] items-start">
    <div>
      <p class="m-0 mb-2.5 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage-dark">Qué incluye</p>
      <h2 class="m-0 mb-6 font-display font-semibold text-[clamp(1.5rem,3vw,1.9rem)] leading-[1.15] text-sn-violet">Todo por escrito, sin sorpresas</h2>
      <ul class="m-0 p-0 list-none flex flex-col gap-3.5">
        {plan.incluye.map((item) => (
          <li class="flex gap-3 items-start text-[15px] leading-relaxed text-gray-600">
            <span class="text-sn-sage-dark text-lg shrink-0 mt-0.5"><Icon name="check-circle-fill" /></span>
            <span>{item}</span>
          </li>
        ))}
      </ul>
    </div>

    <aside class="bg-white rounded-2xl border border-gray-100 shadow-[0_8px_32px_rgba(48,22,109,0.10)] p-6 md:p-7 lg:sticky lg:top-28">
      <p class="m-0 mb-4 text-xs font-semibold tracking-[1.5px] uppercase text-sn-sage-dark">
        {duraciones.length > 1 ? 'Elegí tu opción' : 'Inversión'}
      </p>
      <div class="flex flex-col gap-3">
        {duraciones.map((d, i) => (
          <div class={`rounded-xl p-4 ${i === 0 ? 'bg-[#f6f4fb] border border-sn-violet/10' : 'border border-gray-100'}`}>
            <div class="flex items-center justify-between gap-3">
              <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">{d.label}</span>
              {d.ahorro_label && (
                <span class="text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-sn-sage/25 text-sn-deep">{d.ahorro_label}</span>
              )}
            </div>
            <div class="font-display font-semibold text-[2rem] leading-tight text-sn-violet mt-1.5">{formatARS(d.total)}</div>
            <div class="text-[13px] text-gray-500">≈ {formatARS(d.equiv_valor)} {d.equiv_label}</div>
            <div class="text-[13px] text-gray-600 mt-2">{d.sesiones}</div>
            {d.tarjeta_1pago && (
              <div class="text-xs text-gray-400 mt-2.5 pt-2.5 border-t border-gray-200/70">
                Tarjeta en 1 pago: {formatARS(d.tarjeta_1pago)}
              </div>
            )}
          </div>
        ))}
      </div>

      <div class="mt-6 flex flex-col gap-2.5">
        <CtaWhatsApp text={`Quiero el Plan ${plan.nombre}`} message={mensajeWhatsApp} variant="violet" size="md" />
        {plan.pdf && (
          <a
            href={plan.pdf}
            download
            class="inline-flex items-center justify-center gap-2 px-5 py-2.5 rounded-full border-[1.5px] border-gray-200 text-sn-violet font-semibold text-sm hover:border-sn-sage hover:bg-[#f4faf8] transition"
          ><Icon name="file-earmark-arrow-down" /> Descargar plan en PDF</a>
        )}
      </div>

      <p class="m-0 mt-5 text-xs leading-relaxed text-gray-400">
        {plan.nota_pago ?? 'Pago único al activar el plan. Métodos: transferencia, efectivo en el centro o tarjeta de crédito (10% de recargo en 1 pago; cuotas a consultar).'}
      </p>
    </aside>
  </section>
</BaseLayout>
